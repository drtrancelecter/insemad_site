/* ========== INSEMAD — CSS canónico (limpio) ========== */

/* Variables base */
:root{
  --ink:#0c2f33;
  --ink-soft:#2b5661;
  --hero-h: 560px;
  --radius-sm:10px; --radius-md:12px; --radius-lg:16px;
  --shadow-soft:0 6px 20px rgba(0,0,0,.12);
  --shadow-card:0 6px 20px rgba(0,0,0,.08);
}

/* Reset mínimo */
*{box-sizing:border-box}
html,body{margin:0;padding:0}
a{color:inherit}

/* -------- Topbar (Marca + menú) -------- */
.topbar{
  position:sticky; top:0; z-index:20; height:54px; background:#fff;
  -webkit-font-smoothing:antialiased !important;
  -moz-osx-font-smoothing:grayscale !important;
  text-rendering:optimizeLegibility !important;
  border-bottom:1px solid rgba(0,0,0,.04);
}
.topbar .container{max-width:1100px;margin:0 auto;padding:0 16px;height:54px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px}
.logo-img{width:44px;height:44px;object-fit:contain;image-rendering:-webkit-optimize-contrast;image-rendering:crisp-edges}
.brand-text{font-family:'Inter',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-weight:900;letter-spacing:.01em;color:var(--ink)}
.nav a{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;text-decoration:none;margin-left:16px;color:var(--ink);font-weight:600;font-size:13px}

/* -------- HERO (verde corporativo) -------- */
.hero-inner{max-width:1100px;margin:0 auto;padding:88px 16px 0;width:100% padding-top:24px; padding-top:24px; }
.hero-title{
  margin:0 0 16px; line-height:1.12; color:#fff;
  font-family:'Inter',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-weight:900; font-size:clamp(34px,3.5vw,44px); letter-spacing:-0.02em;
  text-align:center;
 padding-top:24px; }


/* Chips (pequeños) bajo subtítulo */
/* Botón WhatsApp */


/* Slot de video (tarjeta blanca) */
.hero-card{
  margin: 22px auto 64px !important;
  max-width: 860px;
  min-height: 220px;
  background:#fff;
  border-radius:12px;
  box-shadow: 0 6px 20px rgba(0,0,0,.12);
}


/* -------- CTA wrapper (SIN márgenes negativos) -------- */
.cta-wrapper{
  display:flex; justify-content:center; gap:28px; padding-bottom:48px;
}
.cta-btn{
  background:#02676A; color:#fff; border:0; cursor:pointer;
  border-radius:10px; height:40px; padding:0 32px;
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-weight:600; font-size:16px; letter-spacing:.25px; text-decoration:none;
  transition:background .2s ease-in-out
}
.cta-btn:hover{background:#004F52}

/* -------- Secciones blancas / grids reutilizables -------- */
.section{background:#fff;padding:30px 0}
.container{width:100%;max-width:1100px;margin:0 auto;padding:0 16px}

.section-title{font-weight:900;font-size:22px;color:var(--ink);margin:18px 0 14px}
.productos-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:#fff;border-radius:14px;box-shadow:var(--shadow-card);padding:20px;text-align:center}
.card h3{margin:0 0 6px;font-size:16px;font-weight:900;color:var(--ink)}
.card p{margin:0;font-size:13px;color:var(--ink-soft)}

/* Footer */
.footer{padding:26px 0 52px;color:#72939b;text-align:center;font-size:12px}

/* -------- FABs laterales -------- */
.fab-stack{
  position:fixed; right:24px; top:50%; transform:translateY(-50%);
  display:flex; flex-direction:column; gap:18px; z-index:100;
}
.fab{
  width:56px; height:56px; border-radius: 16px; display:grid; place-items:center;
  background:#111; color:#fff; text-decoration:none; font-size:20px; line-height:1;
  box-shadow: 0 6px 20px rgba(0,0,0,.12); transition:transform .15s ease, box-shadow .15s ease
}
.fab:hover{transform:scale(1.05); box-shadow:0 8px 28px rgba(0,0,0,.18)}
.fab.green{background:#50762f} .fab.blue{background:#0a66c2}

/* -------- Responsive -------- */
@media
  .hero-inner{padding-top:72px padding-top:24px; padding-top:24px; }
  .hero-card{
  margin: 22px auto 64px !important;
  max-width: 860px;
  min-height: 220px;
  background:#fff;
  border-radius:12px;
  box-shadow: 0 6px 20px rgba(0,0,0,.12);
 padding-top:24px; }

  .productos-grid{grid-template-columns:1fr}
  .cta-wrapper{gap:16px}


/* — Smoothing cross-browser — */
.topbar{ -moz-osx-font-smoothing: grayscale !important; text-rendering: optimizeLegibility !important; }
/* --- Logo INSEMAD nítido (retina) — override final --- */
.logo-img{
  width:44px !important;
  height:44px !important;
  object-fit: contain !important;
  image-rendering: auto !important; /* evita diente de sierra */
}
/* === Paso A: centrado del hero + whatsapp pill === */
.hero-inner{ text-align:center; padding-top: 18px;  padding-top:24px; padding-top:24px; }
.hero-title{ margin: 0 0 12px !important; line-height: 1.12 !important; letter-spacing: -0.02em !important;  padding-top:24px; }


/* chips bajo el subtítulo (apariencia de píldoras) */
/* botón WhatsApp tipo píldora */

/* tarjeta blanca (slot video) refinada */
.hero-card{
  margin: 22px auto 64px !important;
  max-width: 980px !important;
  min-height: 280px !important;
  border-radius: 16px !important;
  box-shadow: 0 6px 20px rgba(0,0,0,.12);
}
/* — Subtítulo del hero (igual a Punto_Optimo2) — */

/* — Subtítulo del hero (canónico) — */
.hero-subtitle{
  text-align:center;
  font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-weight: 600;
  font-size: 20px;
  letter-spacing: -0.01em;
  color: rgba(255,255,255,.95);
  margin: 8px 0 14px;
}
.hero-inner{ text-align:center;  padding-top:24px; padding-top:24px; }

/* refuerzo de estilo para la píldora WhatsApp dentro del hero */
.hero 
.hero-card{ position:relative; }@media




@media
/* CTA — canónico */
.cta-below{display:flex;justify-content:center;gap: 26px;padding: 44px 0 0}
.cta-below .cta-btn:hover{ background:#023A3D; }
@media (max-width:820px){
  .cta-below{padding:36px 0 0; gap:16px}

  }

.cta-below + .footer{margin-top:18px}

/* WhatsApp como chip (mismo look que .chip) */
/* Chips canónicos (incluye WhatsApp con el mismo look) */
.hero-chips{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin:14px 0 10px; }
.chip,
.whatsapp{
  display:inline-block;
  background:#fff; color:#0b2f33;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-weight:800; font-size:14px; letter-spacing:0;
  padding:10px 18px; border-radius:999px;
  box-shadow:0 4px 14px rgba(0,0,0,.12);
  text-decoration:none; margin:0 6px 10px;
}
.whatsapp:hover{ filter:brightness(.96); }
.cta-below .cta-btn{ background:#0A5A5C; color:#fff; padding:14px 28px; font-size:17px; font-weight:800; letter-spacing:.2px; border-radius:16px; box-shadow:0 6px 18px rgba(0,0,0,.16); display:inline-flex; align-items:center; justify-content:center; line-height:1; }

.cta-below{margin-top: 38px}
@media (max-width:820px){.cta-below{margin-top:24px}}

.site-footer small{color:#0A5A5C;opacity:.8}

.site-footer .container{text-align:center}
.floating-buttons{position:fixed; right:24px; bottom: 40px;transform:none; display:flex; flex-direction:column; gap: 20px; z-index:1000}
.btn-float{width: 60px; height: 60px; border-radius: 20px; display:grid; place-items:center; box-shadow:0 18px 40px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.06)}

.btn-float.blue{background:#0A66C2}
.btn-float:hover{filter:brightness(.92); transform:translateY(-1px)}

@media (max-width:820px){ .floating-buttons{right:14px; bottom: 40px; top:auto; transform:none} .btn-float{width: 60px; height: 60px}  }
.btn-float.black{background:#0B0B0B}
.btn-float.blue img{width:16px; height:16px}
.btn-float img{width:24px; height:24px}
.btn-float.black img{width: 24px; height: 24px; transform:scaleX(1.12) scaleY(0.90)}
.btn-float.green img{width:28px; height:28px; transform:rotate(-18deg) scale(1.06)}
.btn-float.green{background:#56761F}

/* == FAB minimal, safe override (no media) == */
.floating-buttons{
  position:fixed; right:24px; bottom:40px;
  display:flex; flex-direction:column; gap:12px;
  z-index:1000;
}
.btn-float{
  width:60px; height:60px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  box-shadow:0 18px 40px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.06);
}
.btn-float.black{ background:#000 }
.btn-float.green{ background:#4A752C }
.btn-float.blue { background:#0A66C2 }

.btn-float img{ width:22px; height:22px }
.btn-float.green img{ width:28px; height:28px; transform:rotate(-18deg) scale(1.06) }
/* == end FAB == */

/* == FAB minimal, safe override (no media) == */
.floating-buttons{
  position:fixed; right:24px; bottom:40px;
  display:flex; flex-direction:column; gap:12px;
  z-index:1000;
}
.btn-float{
  width:60px; height:60px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  box-shadow:0 18px 40px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.06);
}
.btn-float.black{ background:#000 }
.btn-float.green{ background:#4A752C }
.btn-float.blue { background:#0A66C2 }

.btn-float img{ width:22px; height:22px }
.btn-float.green img{ width:28px; height:28px; transform:rotate(-18deg) scale(1.06) }
/* == end FAB == */

/* ===== Home H1 tuning (Punto_Optimo2) ===== */
#home-title{
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  font-weight: 900;
  letter-spacing: 0.01em;     /* tracking +0.01em */
  line-height: 1.12;
  text-align: center;
  margin-top: 18px;           /* ritmo vertical */
  margin-bottom: 8px;
  max-width: 28ch;            /* 22–28ch para forzar 2 líneas limpias */
  margin-left: auto;
  margin-right: auto;
}
@media (min-width:1440px){                                    /* Desktop 1440 */
  #home-title{ font-size: 56px; }
}
@media (min-width:1024px) and (max-width:1439.98px){          /* Laptop 1024 */
  #home-title{ font-size: 50px; }
}
@media (min-width:768px) and (max-width:1023.98px){           /* Tablet 768 */
  #home-title{ font-size: 44px; }
}
@media (max-width:767.98px){                                  /* Móvil 360 */
  #home-title{ font-size: 36px; }
}
/* ===== end Home H1 tuning ===== */

/* ===== Home subtitle bullets (Punto_Optimo2) ===== */
#home-bullets{
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  font-weight: 600;
  letter-spacing: 0.01em;
  line-height: 1.35;
  text-align: center;
  max-width: 62ch;        /* dentro del rango 56–62ch */
  margin: 8px auto 12px;  /* arriba 8 / abajo 12 */
  display: block;         /* asegura comportamiento de bloque centrado */
}

/* Tamaños por corte */
@media (min-width:1440px){                       /* Desktop 1440 */
  #home-bullets{ font-size: 20px; }
}
@media (min-width:1024px) and (max-width:1439.98px){ /* Laptop 1024 */
  #home-bullets{ font-size: 19px; }
}
@media (min-width:768px) and (max-width:1023.98px){  /* Tablet 768 */
  #home-bullets{ font-size: 18px; }
}
@media (max-width:767.98px){                     /* Móvil 360 */
  #home-bullets{ font-size: 16px; }
}
/* ===== end Home subtitle bullets ===== */

/* ===== Bullets: pelotita blanca estilizada ===== */
.sep-dot{
  display:inline-block;
  width:.45em;                   /* ~8–9px sobre 20px de fuente */
  height:.45em;
  background:rgba(255,255,255,.92);               /* blanco nítido */
  border-radius:999px;           /* círculo perfecto */
  margin:0 .55ch;                /* aire lateral simétrico */
  vertical-align:middle;
  transform:translateY(-.08em);  /* centra ópticamente con el texto */
}
/* Ajuste fino en móvil (ligeramente más pequeña si fuera necesario) */
@media (max-width: 480px){
/* ===== end bullets dot ===== */

/* ==== Bullets: tipografía y no-wrap desktop (override) ==== */
#home-bullets{
  font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  font-weight:600;
  letter-spacing:0.01em;  /* tracking +0.01em */
  line-height:1.35;
  display:inline-block;
  text-align:center;
  margin-top:6px;         /* 6–8 px */
  margin-bottom:10px;     /* 8–12 px */
}

/* Desktop / laptop: fuerzo 1 línea y elimino límite de ancho */
@media (min-width:1024px){
  #home-bullets{ white-space:nowrap; max-width:none; }
}

/* Tablet / móvil: permito 1–2 líneas con tope de ancho */
@media (max-width:1023.98px){
  #home-bullets{ max-width:62ch; white-space:normal; }
}
/* ==== end bullets override ==== */

  .sep-dot{ width:.42em; height:.42em; margin:0 .5ch; }
}
@media
/* Bullets desktop: compactar separador para que no corte la línea */
@media (min-width:1024px){
  .sep-dot{ margin:0 .45ch; } /* antes .55ch */
}

/* Bullets desktop: compactar separador + tracking 0 */
@media (min-width:1024px){
  .sep-dot{ margin:0 .36ch; width:.40em; height:.40em; } /* antes .45ch y .45em */
  #home-bullets{ letter-spacing:0em; }                   /* antes +0.01em */
}

/* Bullets desktop: ajuste fino de tamaño */
@media (min-width:1024px){
  #home-bullets{ font-size:19px; } /* antes 20px */
}

/* === Bullets: mantener 1 línea en desktop ancho === */
@media (min-width:1200px){
  #home-bullets{
    white-space: nowrap !important;
    max-width: none !important;
    font-size: 18.5px;     /* antes 19–20px, bajamos ~2–7% */
    letter-spacing: 0em;   /* más compacto */
    word-spacing: -0.02ch; /* ajuste fino */
  }
  .sep-dot{
    margin: 0 .26ch !important; /* un pelín más cerca */
    width: .34em !important;
    height: .34em !important;
  }
}

/* ===== Nav menu: size + weight (suave) ===== */
header nav a,
nav .menu a,
nav .main-nav a,
.navbar a {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  font-weight: 600;         /* sutilmente más gorditas */
  letter-spacing: 0.01em;   /* micro-tracking para legibilidad */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Tamaños por viewport (prudentes) */
@media (min-width:1024px){   /* desktop/laptop */
  header nav a,
  nav .menu a,
  nav .main-nav a,
  .navbar a { font-size: 18px; line-height: 1.2; }
}
@media (min-width:768px) and (max-width:1023.98px){  /* tablet */
  header nav a,
  nav .menu a,
  nav .main-nav a,
  .navbar a { font-size: 17px; line-height: 1.2; }
}
@media (max-width:767.98px){  /* móvil */
  header nav a,
  nav .menu a,
  nav .main-nav a,
  .navbar a { font-size: 16px; line-height: 1.2; }
}
/* ===== end nav menu overrides ===== */

/* ===== Nav menu v2: mayor especificidad + !important suave ===== */
header nav a,
header .menu a,
header .navbar a,
header .main-nav a,
.site-header nav a,
header ul li > a {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif !important;
  font-weight: 600 !important;       /* un poquito más gorditas */
  letter-spacing: 0.01em !important; /* micro-tracking */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Tamaños por viewport */
@media (min-width:1024px){
  header nav a,
  header .menu a,
  header .navbar a,
  header .main-nav a,
  .site-header nav a,
  header ul li > a { font-size: 18px !important; line-height: 1.2 !important; }
}
@media (min-width:768px) and (max-width:1023.98px){
  header nav a,
  header .menu a,
  header .navbar a,
  header .main-nav a,
  .site-header nav a,
  header ul li > a { font-size: 17px !important; line-height: 1.2 !important; }
}
@media (max-width:767.98px){
  header nav a,
  header .menu a,
  header .navbar a,
  header .main-nav a,
  .site-header nav a,
  header ul li > a { font-size: 16px !important; line-height: 1.2 !important; }
}
/* ===== end nav menu v2 ===== */

/* ===== Nav menu v3: refuerzo específico para .topbar ===== */
.topbar .nav a,
.topbar nav a,
header.topbar nav.nav a {
  font-weight: 600 !important;
  font-size: 18px !important;      /* 17px en tablet, 16px en móvil ya está en v2 */
  letter-spacing: 0.01em !important;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* === Sector 1: Ajuste de .hero-title [Punto_Optimo2] === */
.hero-title {
  font-size: 3rem !important;         /* ≈ 48px */
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center;
  margin-bottom: 0.5rem;
}
/* === Sector 1.1: Fuerza bruta sobre h1.hero-title === */
h1.hero-title {
  font-size: 3rem !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  margin-bottom: 0.5rem !important;
}

/* === Ajuste fino rápido: nav y H1 === */
/* Nav un poco más chico en desktop (sigue 600) */
@media (min-width:1024px){
  header nav a,
  header .menu a,
  header .navbar a,
  header .main-nav a,
  .site-header nav a,
  header ul li > a {
    font-size: 16.5px !important;  /* antes 18px */
    line-height: 1.2 !important;
  }
}

/* H1 un pelín más contenido en desktop ancho */
@media (min-width:1440px){
  #home-title{ font-size:54px; }   /* antes 56px */
}

/* ===== FINAL OVERRIDES (seguras) ===== */
@media (min-width:1440px){
  #home-title{ font-size:54px !important; }  /* compacto como la guía */
}

@media (min-width:1024px){
  /* Menú un poco más grande y semibold */
  header.topbar nav.nav ul li > a,
  header.topbar nav.nav a,
  header .nav a,
  .topbar .nav a {
    font-size:16.5px !important;
    font-weight:600 !important;
    letter-spacing:.01em !important;
    line-height:1.2 !important;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
  }
}

.hero h1 {
  font-size: 40px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  letter-spacing: -0.5px !important;
  color: #fff !important;
}

.hero h2 {
  font-size: 18px !important;
  font-weight: 500 !important;
  color: #ffffffcc !important;
}

.hero .capsula {
  font-size: 14px !important;
  font-weight: 600 !important;
  border-radius: 999px !important;
  padding: 8px 16px !important;
}

.hero-white {
  min-height: 250px !important;
  padding-bottom: 3rem !important;
}

.hero-white .btn {
  font-size: 14px !important;
  font-weight: 700 !important;
  padding: 12px 24px !important;
  border-radius: 6px !important;
}
/* ===== END HERO FINAL Punto_Óptimo2 ===== */
/* ===== HERO FINAL Ajustado Punto_Óptimo2 ===== */
.hero {
  width: 100% !important;
  height: 60vh !important;         /* cubre 55–60% del viewport */
  min-height: 520px !important;
  max-height: 860px !important;
  background: linear-gradient(to bottom, #176B63 0%, #09575B 100%) !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;           /* quitamos padding extra */
}

.hero h1 {
  font-size: 40px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  letter-spacing: -0.5px !important;
  color: #fff !important;
  margin-bottom: 12px !important;
}

.hero h2 {
  font-size: 18px !important;
  font-weight: 500 !important;
  color: #ffffffcc !important;
  margin-bottom: 20px !important;
}
/* ===== END HERO FINAL Ajustado ===== */
/* ===== Pulido seguro de franja inferior ===== */
.hero{
  margin-bottom: 40px !important;   /* separa el hero del bloque blanco */
}

/* Si existe un contenedor blanco específico, le damos mínimos cómodos */
.hero-white{
  min-height: 250px !important;
  padding-bottom: 3rem !important;
}
}